post_install() {
  cat <<'MSG'

  StreamPad is installed. As your normal user (not root):
      systemctl --user enable --now streampad
  then open "StreamPad" from your app launcher.

  StreamPad needs to read your keyboards. If you aren't in the "input" group:
      sudo usermod -aG input "$USER"          (log out and back in)
  or grant the logged-in user access without re-login:
      sudo install -m644 /usr/share/streampad/udev/70-streampad.rules /etc/udev/rules.d/
      sudo udevadm control --reload && sudo udevadm trigger

  Scroll Lock toggles macro mode; Numpad Enter shows the pad, + / − switch profiles.
MSG
}

post_upgrade() {
  echo "  Restart StreamPad to use the new version:  systemctl --user restart streampad"
}

pre_remove() {
  echo "  Stop StreamPad first if it is running:  systemctl --user disable --now streampad"
}
